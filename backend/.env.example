# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection
DATABASE_URL=postgresql://username:password@localhost:5432/tawati_chemist

# Used to sign login tokens — set this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Server port
PORT=4000

# Comma-separated list of origins allowed to call this API
# (the Vite dev server default is http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
